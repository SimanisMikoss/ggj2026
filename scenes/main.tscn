[sub_resource type="GDScript" id="GDScript_oqwcg"]
script/source = "extends Node3D

#masks
@export var mask_textures: Array[Texture2D]
var mask_ids: Array =[]

#characters
@onready var characters_container = get_node(\"%Characters\")
var characters_to_defeat: int
var defeated_characters: int

#damaged vfx
@onready var damaged_vfx: PlayerDamagedVfx = get_node(\"%PlayerDamagedVfx\")

@onready var player: ProtoController = get_node(\"%ProtoController\")

func _ready():
	setup_masks()
	assign_mask_preferences()
	player.player_manager.connect(\"player_damaged\", _on_player_damaged)
	player.player_manager.connect(\"enemy_defeated\", _on_enemy_defeated)

func setup_masks():
	var mask_pickup = get_node(\"mask/Area3D\") 
	var mask_pickup_2 = get_node(\"mask2/Area3D\") 
	var mask_pickup_3 = get_node(\"mask3/Area3D\") 
	var masks = [mask_pickup, mask_pickup_2, mask_pickup_3]
	#create a list of ids
	for i in range(masks.size()):
		mask_ids.append(i)
	mask_ids.shuffle()
	for y in range(masks.size()):
		setup_mask(masks[y], mask_ids[y])
	#shuffle again so monster characters don't have preferences in the same order as masks
	mask_ids.shuffle() 

func _on_player_damaged():
	print(\"should play damaged vfx\")
	damaged_vfx.play_damaged_vfx()

func setup_mask(mask_pickup, mask_id: int):
	mask_pickup.change_visuals(mask_textures[mask_id])
	mask_pickup.mask_id = mask_id

func assign_mask_preferences():
	print(\"assigning mask preferences\")
	var character_count: int = characters_container.get_child_count()
	characters_to_defeat = character_count
	var characters = characters_container.get_children()
	for i in range(character_count):
		characters[i].get_child(0).set_preferred_mask(mask_ids[i])
		
func _on_enemy_defeated():
	defeated_characters += 1
	if(defeated_characters >= characters_to_defeat):
		player.player_manager.end_game(true)
		
"

